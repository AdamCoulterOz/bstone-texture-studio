@page "/"
@implements IDisposable
@inject StudioState State
@inject ImageCodec Codec
@inject GeminiImageClient Gemini
@inject BrowserSupport Support
@inject IJSRuntime JS

<BrowserGate />

<PageTitle>Retro Texture Studio</PageTitle>

<div class="topbar">
    <span class="brand">Retro Texture Studio</span>
    <button class="game-chip" title="@($"this workspace targets {State.Game.Name} — {State.Edition.Name}. Click to change.")"
            @onclick="() => OpenDrawer(Drawer.Game)">
        @State.Game.Name
        <span class="game-chip-edition">@State.Edition.Name</span>
    </button>
    <span class="topbar-spacer"></span>
    <div class="seg view-seg" title="which art the item grid and platter display">
        <button class="seg-btn @(!State.ShowRedraw ? "active" : "")" title="show source art"
                @onclick="() => SetShowRedraw(false)">
            <span class="seg-icon"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 3.00031C15.6569 3.00031 17 4.34345 17 6.00031V14.0003C16.9998 15.657 15.6568 17.0003 14 17.0003H6C4.34324 17.0003 3.00015 15.657 3 14.0003V11.0003H4V14.0003C4.00005 14.3728 4.10188 14.7222 4.2793 15.0208L8.94824 10.4319C9.53183 9.85851 10.4682 9.85851 11.0518 10.4319L15.7207 15.0208C15.8981 14.7222 15.9999 14.3728 16 14.0003V6.00031C16 4.89574 15.1046 4.00031 14 4.00031H10.8926L10.9121 3.92706C10.9955 3.61577 11.0145 3.30229 10.9805 3.00031H14ZM10.3506 11.1458C10.1561 10.9547 9.84394 10.9547 9.64941 11.1458L4.98828 15.7259C5.28506 15.9002 5.63091 16.0003 6 16.0003H14C14.3691 16.0003 14.7149 15.9002 15.0117 15.7259L10.3506 11.1458ZM5.5 3.00031C6.32843 3.00031 7 3.67188 7 4.50031V8.50031C6.99985 9.3286 6.32833 10.0003 5.5 10.0003H2.5C1.67167 10.0003 1.00015 9.3286 1 8.50031V4.50031C1 3.67188 1.67157 3.00031 2.5 3.00031H5.5ZM12.5 6.00031C13.3284 6.00031 14 6.67188 14 7.50031C13.9998 8.3286 13.3283 9.00031 12.5 9.00031C11.6717 9.00031 11.0002 8.3286 11 7.50031C11 6.67188 11.6716 6.00031 12.5 6.00031ZM4.18652 2.00031C4.44553 1.27046 5.22539 0.850353 5.98633 1.05402L8.88477 1.83038C9.68482 2.0449 10.1597 2.86816 9.94531 3.66827L8.91016 7.53156C8.78081 8.01394 8.4293 8.37619 7.99609 8.5423C7.99632 8.52841 7.99899 8.51425 7.99902 8.50031V4.50031C7.99902 4.02509 7.86557 3.58117 7.63379 3.20343C7.19508 2.48277 6.40433 2.0004 5.49902 2.00031H4.18652ZM12.5 7.00031C12.2239 7.00031 12 7.22416 12 7.50031C12.0002 7.77632 12.224 8.00031 12.5 8.00031C12.776 8.00031 12.9998 7.77632 13 7.50031C13 7.22416 12.7761 7.00031 12.5 7.00031Z" fill="currentColor"/></svg></span>
        </button>
        <button class="seg-btn @(State.ShowRedraw ? "active" : "")" title="show redrawn art"
                @onclick="() => SetShowRedraw(true)">
            <span class="seg-icon"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.12226 0.282251L4.77398 1.35305C4.66568 1.67859 4.48288 1.97441 4.24012 2.21699C3.99735 2.45957 3.70131 2.64223 3.37552 2.75044L2.3039 3.09845L2.28247 3.10381C2.19987 3.13292 2.12835 3.18692 2.07776 3.25836C2.02717 3.3298 2 3.41516 2 3.50268C2 3.5902 2.02717 3.67556 2.07776 3.747C2.12835 3.81844 2.19987 3.87244 2.28247 3.90155L3.35409 4.24956C3.67988 4.35778 3.97592 4.54044 4.21869 4.78302C4.46145 5.0256 4.64425 5.32141 4.75255 5.64696L5.10082 6.71775C5.12996 6.80029 5.184 6.87175 5.2555 6.92231C5.32699 6.97286 5.41242 7.00001 5.5 7.00001C5.58758 7.00001 5.67301 6.97286 5.7445 6.92231C5.75156 6.91732 5.75843 6.91213 5.76514 6.90675C5.82641 6.85755 5.87291 6.79215 5.89918 6.71775L6.24745 5.64696C6.26617 5.59014 6.28716 5.53422 6.31034 5.47932C6.42037 5.21872 6.57977 4.98116 6.78032 4.77999C6.81846 4.74173 6.85792 4.70496 6.89861 4.66973C7.11698 4.48064 7.37081 4.33588 7.64592 4.24421L8.71753 3.8962C8.80013 3.86708 8.87165 3.81308 8.92224 3.74164C8.97283 3.6702 9 3.58484 9 3.49733C9 3.40981 8.97283 3.32445 8.92224 3.25301C8.87165 3.18157 8.80013 3.12757 8.71753 3.09845L7.64592 2.75044C7.32409 2.63941 7.03232 2.45549 6.79344 2.21307C6.55456 1.97065 6.37503 1.67631 6.26889 1.35305L5.92061 0.282251C5.89147 0.19972 5.83743 0.128252 5.76594 0.0776997C5.69444 0.0271473 5.60902 0 5.52143 0C5.43385 0 5.34842 0.0271473 5.27693 0.0776997C5.20543 0.128252 5.15139 0.19972 5.12226 0.282251ZM0.217072 8.21319L0.982513 7.96461C1.21522 7.88731 1.42668 7.75684 1.60008 7.58357C1.77349 7.4103 1.90406 7.199 1.98141 6.96647L2.23018 6.20161C2.25099 6.14266 2.2896 6.09161 2.34066 6.05551C2.39173 6.0194 2.45275 6.00001 2.51531 6.00001C2.57787 6.00001 2.63889 6.0194 2.68996 6.05551C2.74102 6.09161 2.77962 6.14266 2.80044 6.20161L3.0492 6.96647C3.12502 7.19737 3.25325 7.40762 3.42389 7.58077C3.59452 7.75392 3.80292 7.8853 4.0328 7.96461L4.79824 8.21319C4.85723 8.23398 4.90832 8.27255 4.94446 8.32358C4.98059 8.37461 5 8.43558 5 8.4981C5 8.56061 4.98059 8.62158 4.94446 8.67261C4.90832 8.72364 4.85723 8.76221 4.79824 8.78301L4.0328 9.03158C3.79968 9.10926 3.58795 9.24032 3.41452 9.41428C3.24109 9.58824 3.11074 9.80031 3.0339 10.0335L2.78513 10.7984C2.76431 10.8574 2.72571 10.9084 2.67465 10.9445C2.62358 10.9806 2.56256 11 2.5 11C2.43744 11 2.37642 10.9806 2.32535 10.9445C2.27429 10.9084 2.23569 10.8574 2.21487 10.7984L1.9661 10.0335C1.88875 9.80101 1.75818 9.58972 1.58478 9.41645C1.41137 9.24317 1.19991 9.11271 0.967204 9.03541L0.201763 8.78683C0.142767 8.76603 0.0916796 8.72746 0.0555429 8.67643C0.0194063 8.62541 0 8.56443 0 8.50192C0 8.43941 0.0194063 8.37844 0.0555429 8.32741C0.0916796 8.27638 0.142767 8.23781 0.201763 8.21701L0.217072 8.21319ZM3 14V11.9009C3.08531 11.8659 3.16702 11.8221 3.24386 11.7696C3.46406 11.6094 3.6242 11.399 3.72429 11.1486L3.98453 10.3473C3.9894 10.3343 3.99452 10.3213 4 10.3084V14C4 14.3726 4.10191 14.7215 4.27937 15.0201L8.94868 10.432C9.53227 9.85859 10.4677 9.85859 11.0513 10.432L15.7206 15.0201C15.8981 14.7215 16 14.3726 16 14V6C16 4.89543 15.1046 4 14 4H9.9091C9.96903 3.84162 10 3.67231 10 3.49611C10 3.32279 9.97003 3.15614 9.91202 3H14C15.6569 3 17 4.34315 17 6V14C17 15.6569 15.6569 17 14 17H6C4.34315 17 3 15.6569 3 14ZM14 7.5C14 8.32843 13.3284 9 12.5 9C11.6716 9 11 8.32843 11 7.5C11 6.67157 11.6716 6 12.5 6C13.3284 6 14 6.67157 14 7.5ZM13 7.5C13 7.22386 12.7761 7 12.5 7C12.2239 7 12 7.22386 12 7.5C12 7.77614 12.2239 8 12.5 8C12.7761 8 13 7.77614 13 7.5ZM14 16C14.3692 16 14.7149 15.9 15.0118 15.7256L10.3504 11.1453C10.1559 10.9542 9.84409 10.9542 9.64956 11.1453L4.98824 15.7256C5.28505 15.9 5.63085 16 6 16H14Z" fill="currentColor"/></svg></span>
        </button>
    </div>
    <button class="pack-btn" disabled="@(!State.CanPack || State.Busy)"
            title="@(State.CanPack
                       ? $"build the {State.Game.Name} pack into {State.Workspace.Name}/{StudioState.PackFolderName}"
                       : State.Workspace.IsOpen
                           ? "apply some redraws first"
                           : "open a workspace first")"
            @onclick="State.PackAsync">Pack</button>
    <div class="settings-wrap">
        <button class="@(_settingsOpen || _drawer != Drawer.None ? "active" : "")"
                @onclick="() => _settingsOpen = !_settingsOpen">Settings <IconChevron Dir="down" Size="14" /></button>
        @if (_settingsOpen)
        {
            <div class="menu-backdrop" @onclick="() => _settingsOpen = false"></div>
            <div class="settings-menu">
                <button @onclick="() => OpenDrawerFromMenu(Drawer.Game)">Game</button>
                <button @onclick="() => OpenDrawerFromMenu(Drawer.Model)">Model API</button>
                <button @onclick="() => OpenDrawerFromMenu(Drawer.Style)">Style</button>
                <button @onclick="() => OpenDrawerFromMenu(Drawer.Generation)">Generation</button>
                <button @onclick="() => OpenDrawerFromMenu(Drawer.Application)">Application</button>
            </div>
        }
    </div>
</div>

@if (_styleRefLightbox is { } lightboxRef)
{
    var refList = State.Project.Generation.StyleRefs;
    var refIndex = refList.IndexOf(lightboxRef);
    <StudioLightbox Title="Style reference"
                    Hint="@($"image {refIndex + 1}/{refList.Count}")"
                    ImageUrl="@State.StyleRefFullUrl(lightboxRef)"
                    OnClose="() => _styleRefLightbox = null"
                    OnPrev="() => StepStyleRefLightbox(-1)"
                    OnNext="() => StepStyleRefLightbox(+1)">
        <LeftContent>
            <label>Context
                <textarea rows="8" placeholder="context — how should the model use this image?"
                          value="@lightboxRef.Context"
                          @onchange="e => { lightboxRef.Context = (string?)e.Value ?? string.Empty; State.Notify(); }"></textarea>
            </label>
        </LeftContent>
        <ImageOverlay>
            <label class="file-button lightbox-swap" title="replace this image, keeping its context and position">
                Swap
                <InputFile OnChange="e => OnStyleRefSwapSelected(lightboxRef, e)" />
            </label>
        </ImageOverlay>
    </StudioLightbox>
}

@if (_drawer != Drawer.None)
{
    <div class="drawer-backdrop" @onclick="CloseDrawer"></div>
    <div class="drawer">
        <div class="drawer-header">
            <strong>@(_drawer switch { Drawer.Game => "Game", Drawer.Model => "Model API", Drawer.Style => "Style", Drawer.Application => "Application", _ => "Generation" })</strong>
            <button class="close-btn" @onclick="CloseDrawer"><IconDismiss Size="13" /></button>
        </div>
        @if (_drawer == Drawer.Game)
        {
            <div class="drawer-body">
        <span class="wide"><strong class="ref-heading">Source game</strong></span>
        <span class="hint wide">Each workspace targets one game. The plugin decides how its
            art is read, which tiles pair light/dark, and where a packed texture lands in the
            mod directory.</span>
        <label class="wide">Game
            <select value="@State.Project.GameId" disabled="@(!State.CanChangeGame)"
                    @onchange="e => State.SetGame((string?)e.Value ?? State.Project.GameId)">
                @foreach (var game in State.Games)
                {
                    <option value="@game.Id">@game.Name</option>
                }
            </select>
        </label>
        <span class="hint wide">@State.Game.Description</span>
        @if (!State.CanChangeGame)
        {
            <span class="hint wide">Locked: this workspace already has imported or curated
                tiles, and tile ids mean different things in a different game. Start a fresh
                workspace to work on another game.</span>
        }
        <label class="wide" title="which release of the game — picks the mod-dir folder and the engine reference table">Edition
            <select value="@(State.EditionIsAuto ? "" : State.Project.EditionId)"
                    @onchange="e => State.SetEdition((string?)e.Value)">
                <option value="">auto (@State.Edition.Name)</option>
                @foreach (var edition in State.Game.Editions)
                {
                    <option value="@edition.Id">@edition.Name</option>
                }
            </select>
        </label>
        <span class="wide"><strong class="ref-heading">Game data</strong></span>
        <span class="hint wide">Supply your own legally owned game files: @State.Game.ImportHint.
            They are copied into the workspace and decoded into <code>originals/</code>.</span>
        @if (State.Game.Locator is { } locator)
        {
            <span class="hint wide">@locator.SearchHint</span>
            <div class="wide search-row">
                @if (State.ContentSearch.IsOpen)
                {
                    <span class="search-root" title="the folder being searched">
                        🔍 @State.ContentSearch.Name</span>
                    <button disabled="@State.Searching"
                            @onclick="State.SearchForGameDataAsync">Rescan</button>
                    <button class="close-btn" title="stop searching this folder"
                            @onclick="State.ForgetContentRootAsync"><IconDismiss Size="11" /></button>
                }
                else
                {
                    <button disabled="@State.Searching"
                            @onclick="State.PickAndSearchAsync">Choose a folder to search…</button>
                }
            </div>
            @if (State.Searching)
            {
                <span class="hint wide">Searching…</span>
            }
            else if (State.FoundSources is { } found)
            {
                @foreach (var source in found.Sources)
                {
                    var located = source;
                    <div class="wide found-row">
                        <span class="found-what">
                            <strong>@located.Edition.Name</strong>
                            <span class="badge store">@located.StoreLabel</span>
                        </span>
                        <span class="found-where" title="@located.AssetPath">
                            @located.DisplayPath/@located.AssetFileName</span>
                        <button disabled="@(!State.Workspace.IsOpen)"
                                title="@(State.Workspace.IsOpen ? "import this copy" : "open a workspace first")"
                                @onclick="() => State.ImportFoundSourceAsync(located)">Import</button>
                    </div>
                }
                @if (found.Sources.Count == 0)
                {
                    <span class="hint wide">
                        Nothing found in @found.DirectoriesVisited folder(s).
                        @(found.Exhausted
                            ? "The search hit its limit — choose a folder closer to the game."
                            : "Try a folder further up, or pick the file yourself below.")</span>
                }
                else if (found.Exhausted)
                {
                    <span class="hint wide">The search hit its limit, so there may be more —
                        choose a folder closer to the game to be sure.</span>
                }
            }
        }
        <div class="wide">
            <label class="file-button @(State.Workspace.IsOpen ? "" : "disabled")"
                   title="@(State.Workspace.IsOpen ? $"import {State.Game.ImportHint}" : "open a workspace first")">
                <span class="btn-label">@(State.Game.Locator is null ? "Import game data" : "Pick the file yourself…")</span>
                <InputFile OnChange="OnGameDataSelected" accept="@State.Game.ImportAccept"
                           disabled="@(!State.Workspace.IsOpen)" />
            </label>
        </div>
        @if (State.Archive is { } archive)
        {
            <span class="hint wide">Loaded <code>@archive.SourceName</code> —
                @State.TileKeys.Count tiles.</span>
        }
        <span class="wide"><strong class="ref-heading">Installing a pack</strong></span>
        @{
            var guide = State.Game.InstallGuide;
            var packFolder = State.Workspace.IsOpen
                ? $"{State.Workspace.Name}/{StudioState.PackFolderName}"
                : $"<workspace>/{StudioState.PackFolderName}";
        }
        <span class="hint wide">Generate the pack with the <strong>Pack</strong> button in the
            title bar. It is written to <code>@packFolder</code> — keep it anywhere on disk you
            like. Then reference it with the
            <a href="@guide.PortUrl" target="_blank" rel="noopener">@guide.PortName</a> launcher;
            <a href="@guide.PackInstructionsUrl" target="_blank" rel="noopener">instructions here</a>.</span>
        @if (guide.ExtraStep is { } extraStep)
        {
            <span class="hint wide">You will also need to @extraStep@if (guide.ExtraStepUrl is { } extraUrl)
                {<text> (</text><a href="@extraUrl" target="_blank" rel="noopener">how</a><text>)</text>}<text>.</text></span>
        }
            </div>
        }
        else if (_drawer == Drawer.Model)
        {
            <div class="drawer-body">
        <label>Gemini API key <input type="password" @bind="State.ApiKey" placeholder="saved to workspace" /></label>
        <label>OpenAI API key <input type="password" @bind="State.OpenAiApiKey" placeholder="saved to workspace" /></label>
        <label class="wide">Model
            <span class="model-row">
                <select value="@State.Project.Generation.ModelId" @onchange="OnModelChanged">
                    @foreach (var model in ModelOptions())
                    {
                        <option value="@model">@model</option>
                    }
                </select>
                <button class="icon-btn" title="refresh the model list from the API"
                        disabled="@(string.IsNullOrWhiteSpace(State.ApiKey))" @onclick="RefreshModels">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10C4 6.68629 6.68629 4 10 4C11.7766 4 13.3732 4.77191 14.4723 6H12.5C12.2239 6 12 6.22386 12 6.5C12 6.77614 12.2239 7 12.5 7H15.5C15.7761 7 16 6.77614 16 6.5V3.5C16 3.22386 15.7761 3 15.5 3C15.2239 3 15 3.22386 15 3.5V5.10109C13.7299 3.80499 11.9591 3 10 3C6.13401 3 3 6.13401 3 10C3 13.866 6.13401 17 10 17C13.866 17 17 13.866 17 10C17 9.8191 16.9931 9.6397 16.9796 9.46207C16.9587 9.18673 16.7185 8.98049 16.4431 9.00144C16.1678 9.02239 15.9615 9.26258 15.9825 9.53793C15.9941 9.69034 16 9.84443 16 10C16 13.3137 13.3137 16 10 16C6.68629 16 4 13.3137 4 10Z" fill="currentColor"/></svg>
                </button>
            </span>
        </label>
        @if (StudioState.ThinkingLevelsFor(State.Project.Generation.ModelId) is { Length: > 0 } levels)
        {
            <label title="model reasoning effort — higher can improve layout/instruction compliance at some latency/cost">Effort
                <select value="@ResolvedDrawerThinking" @onchange="OnThinkingSettingChanged">
                    @foreach (var level in levels)
                    {
                        <option value="@level">@level@(level == StudioState.DefaultThinkingFor(State.Project.Generation.ModelId) ? " (default)" : "")</option>
                    }
                </select>
            </label>
        }
        else
        {
            <span class="hint">this model has no thinking control</span>
        }
        <div class="inline-selects wide">
            <label title="each Generate click produces this many versions, generated one after another (in series) with different top-p values">Versions per generate
                <select @bind="State.Project.Generation.VersionCount" @bind:after="State.Notify">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </label>
            <label title="how many jobs may call the API at once — 1 runs everything in series (rate-limit friendly); takes effect for jobs started after the change">Max concurrent jobs
                <select @bind="State.Project.Generation.MaxConcurrentJobs" @bind:after="State.Notify">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>
            </label>
        </div>
        <span class="hint">output size is computed per sheet from its cell grid and tile px</span>
            </div>
        }
        else if (_drawer == Drawer.Style)
        {
            <div class="drawer-body">
        <label class="wide" title='injected into every generation prompt as "Style Description: …"'>Description
            <textarea rows="4" @bind="State.Project.Generation.StylePrompt"
                      @bind:event="oninput" @bind:after="State.Notify"></textarea>
        </label>
        <div class="wide">
            <div class="ref-header">
                <strong title="attached in order after the sheet; each context is quoted against its image index in the prompt">Reference images</strong>
                <label class="file-button ref-add" title="add reference images">
                    <IconAdd Size="14" />
                    <InputFile OnChange="OnStyleRefsSelected" multiple />
                </label>
                <button class="@(_styleRefEdit ? "active" : "")"
                        @onclick="() => _styleRefEdit = !_styleRefEdit">@(_styleRefEdit ? "Done" : "Edit")</button>
            </div>
            @foreach (var (reference, refIndex) in State.Project.Generation.StyleRefs.Select((r, i) => (r, i)))
            {
                var styleRef = reference;
                var dropIndex = refIndex;
                <div class="style-ref-row @(_styleDropIndex == dropIndex && _dragStyleRef is not null ? "drop-indicator" : "")"
                     @ondragover:preventDefault
                     @ondragover="() => StyleRefDragOver(dropIndex)"
                     @ondrop="() => DropStyleRef(dropIndex)">
                    @if (_styleRefEdit)
                    {
                        <span class="drag-handle" title="drag to reorder" draggable="true"
                              @ondragstart="() => _dragStyleRef = styleRef"
                              @ondragend="ResetStyleRefDrag">☰</span>
                    }
                    <div class="style-ref-thumb-wrap @(_styleRefEdit ? "" : "clickable")"
                         @onclick="() => { if (!_styleRefEdit) { _styleRefLightbox = styleRef; } }">
                        <img class="style-ref-thumb" src="@State.StyleRefUrl(styleRef)" alt="style reference" />
                        @if (_styleRefEdit)
                        {
                            <label class="file-button style-ref-swap" title="replace this image, keeping its context and position"
                                   @onclick:stopPropagation>
                                swap
                                <InputFile OnChange="e => OnStyleRefSwapSelected(styleRef, e)" />
                            </label>
                        }
                    </div>
                    <textarea class="style-ref-context" rows="3"
                              placeholder="context — how should the model use this image?"
                              value="@styleRef.Context"
                              @onchange="e => { styleRef.Context = (string?)e.Value ?? string.Empty; State.Notify(); }"></textarea>
                    @if (_styleRefEdit)
                    {
                        <span class="frame-remove" title="detach this reference"
                              @onclick="() => State.RemoveStyleRef(styleRef)"><IconDismiss Size="11" /></span>
                    }
                </div>
            }
            @if (_styleRefEdit && State.Project.Generation.StyleRefs.Count > 0)
            {
                <div class="frame-drop-tail @(_styleDropIndex == State.Project.Generation.StyleRefs.Count && _dragStyleRef is not null ? "drop-indicator" : "")"
                     @ondragover:preventDefault
                     @ondragover="() => StyleRefDragOver(State.Project.Generation.StyleRefs.Count)"
                     @ondrop="() => DropStyleRef(State.Project.Generation.StyleRefs.Count)">drop here to move to end</div>
            }
        </div>
            </div>
        }
        else if (_drawer == Drawer.Application)
        {
            <div class="drawer-body">
        <span class="wide"><strong class="ref-heading">Notifications</strong></span>
        <span class="hint wide">Choose which notification banners appear at the top of the
            main pane. Hidden kinds still show in the jobs list and statuses.</span>
        <div class="notif-filter">
            <button class="@(_notifFilterOpen ? "active" : "")"
                    @onclick="() => _notifFilterOpen = !_notifFilterOpen">
                Shown notifications <IconChevron Dir="@(_notifFilterOpen ? "up" : "down")" Size="14" /></button>
            @if (_notifFilterOpen)
            {
                <div class="notif-list">
                    @foreach (var kind in StudioState.NotificationKinds)
                    {
                        var notifKind = kind;
                        <label class="toggle notif-row">
                            <input type="checkbox"
                                   checked="@(!State.Project.Ui.HiddenNotifications.Contains(notifKind))"
                                   @onchange="() => State.ToggleNotificationKind(notifKind)" />
                            @(notifKind switch
                            {
                                "Errors" => "Errors & warnings",
                                "Jobs" => "Job updates",
                                "Progress" => "Progress",
                                "Workspace" => "Workspace",
                                _ => "General info",
                            })
                        </label>
                    }
                </div>
            }
        </div>
            </div>
        }
        else
        {
            <div class="drawer-body dark-panel">
            <span class="wide"><strong class="ref-heading">Sprite Size (pixels)</strong></span>
            <span class="hint wide">If 1:1, no scaling will be applied, otherwise the generated
                image will be scaled up or down to the target size. Both persist with the project.</span>
            <div class="inline-selects wide">
                <span class="field-col">
                    <label title="cell size composed into outgoing generation sheets">Generated
                        <select @bind="State.Project.Generation.TilePx" @bind:after="State.Notify">
                            <option value="128">128</option>
                            <option value="192">192</option>
                            <option value="256">256</option>
                            <option value="512">512</option>
                        </select>
                    </label>
                    <span class="hint">what the model paints each cell at — the sheet's output
                        size is computed per group from its cell grid</span>
                </span>
                <span class="field-col">
                    <label title="resolution each cell is cut back to when slicing results">Target
                        <select @bind="State.SliceTargetPx" @bind:after="State.Notify">
                            <option value="256">256</option>
                            <option value="512">512</option>
                            <option value="1024">1024</option>
                        </select>
                    </label>
                    <span class="hint">what each cell becomes in the workspace after slicing</span>
                </span>
            </div>
            <span class="wide"><strong class="ref-heading">Dark variants</strong></span>
            <span class="hint wide">Adjust the sliders until each pair matches as closely as
                possible — left is the light original darkened live, right is the true 1993 dark.</span>
            <label>multiply @State.Project.DarkParams.Multiply.ToString("F2")
                <input type="range" min="0.30" max="1.00" step="0.01"
                       value="@State.Project.DarkParams.Multiply"
                       @oninput="e => SetDark(m: double.Parse((string)e.Value!))" />
            </label>
            <label>gamma @State.Project.DarkParams.Gamma.ToString("F2")
                <input type="range" min="0.70" max="1.40" step="0.01"
                       value="@State.Project.DarkParams.Gamma"
                       @oninput="e => SetDark(g: double.Parse((string)e.Value!))" />
            </label>
            <label>saturation @State.Project.DarkParams.Saturation.ToString("F2")
                <input type="range" min="0.50" max="1.30" step="0.01"
                       value="@State.Project.DarkParams.Saturation"
                       @oninput="e => SetDark(s: double.Parse((string)e.Value!))" />
            </label>
            @if (_darkPairs.Count > 0)
            {
                <div class="pair-strip wide">
                    @foreach (var pair in _darkPairs)
                    {
                        <span class="pair">
                            <img src="@pair.GenUrl" alt="generated dark" title="light original, darkened live" />
                            <img src="@pair.RefUrl" alt="original dark" title="original 1993 dark" />
                        </span>
                    }
                </div>
            }
            else
            {
                <span class="hint wide">no native light/dark pairs available — import game data first</span>
            }
            <span class="wide"><strong class="ref-heading">Lighten dark variants</strong></span>
            <span class="hint wide">Alternate Dark originals are brightened with this transform
                before entering generation sheets, so the model redraws them as light art (dark
                inputs tend to come back as noise); the result is re-darkened for display and
                packing by the Dark variants transform above. Match each lightened dark (left)
                to its light sibling (right).</span>
            <label>multiply @State.Project.LightenParams.Multiply.ToString("F2")
                <input type="range" min="1.00" max="2.50" step="0.01"
                       value="@State.Project.LightenParams.Multiply"
                       @oninput="e => SetLighten(m: double.Parse((string)e.Value!))" />
            </label>
            <label>gamma @State.Project.LightenParams.Gamma.ToString("F2")
                <input type="range" min="0.50" max="1.20" step="0.01"
                       value="@State.Project.LightenParams.Gamma"
                       @oninput="e => SetLighten(g: double.Parse((string)e.Value!))" />
            </label>
            <label>saturation @State.Project.LightenParams.Saturation.ToString("F2")
                <input type="range" min="0.60" max="1.40" step="0.01"
                       value="@State.Project.LightenParams.Saturation"
                       @oninput="e => SetLighten(s: double.Parse((string)e.Value!))" />
            </label>
            @if (_lightenPairs.Count > 0)
            {
                <div class="pair-strip wide">
                    @foreach (var pair in _lightenPairs)
                    {
                        <span class="pair">
                            <img src="@pair.GenUrl" alt="lightened dark" title="dark original, lightened live" />
                            <img src="@pair.RefUrl" alt="light sibling" title="its light sibling" />
                        </span>
                    }
                </div>
            }
            else
            {
                <span class="hint wide">no Alternate Dark pairs available — import game data first</span>
            }
            </div>
        }
    </div>
}

