@code {
    private enum Drawer { None, Game, Model, Style, Generation, Application }

    /// <summary>Open a drawer directly (the topbar game chip), rather than toggling it.</summary>
    private void OpenDrawer(Drawer drawer)
    {
        if (_drawer != drawer)
        {
            ToggleDrawer(drawer);
        }
    }

    private bool _styleRefEdit;
    private bool _settingsOpen;
    private StyleRefInfo? _styleRefLightbox;
    private StyleRefInfo? _dragStyleRef;
    private int? _styleDropIndex;

    private void OpenDrawerFromMenu(Drawer drawer)
    {
        _settingsOpen = false;
        ToggleDrawer(drawer);
    }

    /// <summary>How many selected frames the game would pair — Auto-pair only appears when
    /// there is something for it to do.</summary>
    private int PairableSelectedCount() =>
        State.SelectedItems
            .SelectMany(i => i.TileKeys)
            .Count(k => State.Game.AutoPairRole(k) is not null);

    private void StepStyleRefLightbox(int direction)
    {
        var refs = State.Project.Generation.StyleRefs;
        if (_styleRefLightbox is null || refs.Count == 0)
        {
            return;
        }
        var index = Math.Max(0, refs.IndexOf(_styleRefLightbox));
        _styleRefLightbox = refs[(index + direction + refs.Count) % refs.Count];
    }

    private void StyleRefDragOver(int index)
    {
        if (_dragStyleRef is not null && _styleDropIndex != index)
        {
            _styleDropIndex = index;
        }
    }

    private void ResetStyleRefDrag()
    {
        _dragStyleRef = null;
        _styleDropIndex = null;
    }

    private void DropStyleRef(int targetIndex)
    {
        if (_dragStyleRef is not { } dragged)
        {
            return;
        }
        ResetStyleRefDrag();
        var refs = State.Project.Generation.StyleRefs;
        var oldIndex = refs.IndexOf(dragged);
        if (oldIndex < 0)
        {
            return;
        }
        refs.RemoveAt(oldIndex);
        if (oldIndex < targetIndex)
        {
            targetIndex--;
        }
        refs.Insert(Math.Clamp(targetIndex, 0, refs.Count), dragged);
        State.Notify();
    }

    private Drawer _drawer = Drawer.None;
    private bool _hasStoredWorkspace;
    private List<string> _models = [];
    private DotNetObjectReference<Home>? _selfRef;

    private static readonly string[] KnownImageModels =
    [
        "gpt-image-2",
        "gpt-image-1.5",
        "gpt-image-1",
        "gpt-image-1-mini",
        "gemini-3-pro-image",
        "gemini-3-pro-image-preview",
        "gemini-3.1-flash-image",
        "gemini-3.1-flash-image-preview",
        "gemini-3.1-flash-lite-image",
        "gemini-2.5-flash-image",
    ];

    /// <summary>Live model list when fetched, else the known roster — always including the
    /// currently configured id so the select never loses its value.</summary>
    private IEnumerable<string> ModelOptions() =>
        (_models.Count > 0 ? _models : KnownImageModels.ToList())
        .Concat(KnownImageModels.Where(m => m.StartsWith("gpt-image")))
        .Append(State.Project.Generation.ModelId)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .OrderBy(m => m);

    /// <summary>What the drawer's thinking select displays: the explicit setting when one
    /// is pinned, else the model's own default.</summary>
    private string ResolvedDrawerThinking
    {
        get
        {
            var setting = State.Project.Generation.ThinkingLevel;
            return setting.Length > 0 &&
                   StudioState.ThinkingLevelsFor(State.Project.Generation.ModelId).Contains(setting)
                ? setting
                : StudioState.DefaultThinkingFor(State.Project.Generation.ModelId);
        }
    }

    private void OnThinkingSettingChanged(ChangeEventArgs e)
    {
        var picked = (string?)e.Value ?? "";
        // Picking the model's default level stores "follow default" so switching models
        // keeps tracking each model's own default; any other pick pins that level.
        State.Project.Generation.ThinkingLevel =
            picked == StudioState.DefaultThinkingFor(State.Project.Generation.ModelId) ? "" : picked;
        State.Notify();
    }

    private void OnModelChanged(ChangeEventArgs e)
    {
        State.Project.Generation.ModelId = (string?)e.Value ?? "";
        // Drop a thinking level the new model doesn't support back to default.
        if (!StudioState.ThinkingLevelsFor(State.Project.Generation.ModelId)
                .Contains(State.Project.Generation.ThinkingLevel))
        {
            State.Project.Generation.ThinkingLevel = "";
        }
        State.Notify();
    }

    private void ToggleDrawer(Drawer drawer)
    {
        _drawer = _drawer == drawer ? Drawer.None : drawer;
        if (_drawer == Drawer.None)
        {
            FlushSettings();
        }
        if (_drawer == Drawer.Generation)
        {
            _ = RefreshPairPreviewsAsync();
        }
        if (_drawer == Drawer.Model && _models.Count == 0 &&
            !string.IsNullOrWhiteSpace(State.ApiKey))
        {
            _ = RefreshModels();
        }
    }

    private void CloseDrawer()
    {
        _drawer = Drawer.None;
        FlushSettings();
    }

    /// <summary>Write project.json immediately — drawer edits must survive an instant
    /// reload, not wait out the auto-save debounce.</summary>
    private void FlushSettings()
    {
        if (State.Workspace.IsOpen)
        {
            _ = State.SaveProjectToWorkspaceAsync();
        }
    }

    private bool HasSelection => State.SelectedItems.Count > 0;

    /// <summary>The Properties column is hidden entirely without a selection; with one it
    /// follows the user's last open/closed choice.</summary>
    private bool PropsVisible => HasSelection && !_collapsed[1];

    private async Task ToggleSidebar()
    {
        _collapsed[0] = !_collapsed[0];
        await PersistLayoutAsync();
    }

    private async Task TogglePropsColumn()
    {
        _collapsed[1] = !_collapsed[1];
        await PersistLayoutAsync();
    }

    private async Task BumpSize(int which, int direction)
    {
        if (which == 0)
        {
            State.BumpItemTileSize(direction);
        }
        else
        {
            State.BumpFrameThumbSize(direction);
        }
        await PersistLayoutAsync();
        State.Notify();
    }

    private void SetShowRedraw(bool value)
    {
        State.ShowRedraw = value;
        State.Notify();
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        // Settle the capability question before anything paints: the gate is a child
        // component with no parameters, so leaving it to a later StateHasChanged would
        // leave it rendered against the pre-check state.
        await Support.EnsureCheckedAsync();
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        _selfRef?.Dispose();
    }

    private void OnStateChanged()
    {
        if (_drawer == Drawer.Generation)
        {
            _ = RefreshPairPreviewsAsync();
        }
        StateHasChanged();
    }

    // ---- Dark / lighten variant tuning (lives in the Generation drawer) ----

    private List<(string GenUrl, string RefUrl)> _darkPairs = [];
    private List<(string GenUrl, string RefUrl)> _lightenPairs = [];
    private string? _pairsStamp;

    private void SetDark(double? m = null, double? g = null, double? s = null)
    {
        var p = State.Project.DarkParams;
        State.Project.DarkParams = new DarkParams(m ?? p.Multiply, g ?? p.Gamma, s ?? p.Saturation);
        State.InvalidateDerivedDarks();
        _ = RefreshPairPreviewsAsync();
    }

    private void SetLighten(double? m = null, double? g = null, double? s = null)
    {
        var p = State.Project.LightenParams;
        State.Project.LightenParams = new DarkParams(m ?? p.Multiply, g ?? p.Gamma, s ?? p.Saturation);
        State.Notify();
        _ = RefreshPairPreviewsAsync();
    }

    /// <summary>Up to 5 native light/dark pairs (dark transform live on the light) and up
    /// to 5 AlternateDark pairs (lighten transform live on the dark) — RAW originals only.</summary>
    private async Task RefreshPairPreviewsAsync()
    {
        if (State.Archive is null)
        {
            _darkPairs = [];
            _lightenPairs = [];
            return;
        }
        var stamp = $"{State.Project.DarkParams}|{State.Project.LightenParams}";
        if (stamp == _pairsStamp)
        {
            return;
        }
        _pairsStamp = stamp;
        var dark = new List<(string GenUrl, string RefUrl)>();
        var lighten = new List<(string GenUrl, string RefUrl)>();
        foreach (var (key, meta) in State.Project.Meta)
        {
            try
            {
                var lightKey = meta.LightSourceKey ?? State.DefaultLightSource(key);
                if (lightKey is null)
                {
                    continue;
                }
                if (meta.Role == PairRole.DerivedDark && dark.Count < 5)
                {
                    dark.Add((
                        await Codec.ToDataUrlAsync(DarkGenerator.Apply(
                            State.GetOriginal(lightKey), State.Project.DarkParams)),
                        await Codec.ToDataUrlAsync(State.GetOriginal(key))));
                }
                else if (meta.Role == PairRole.AlternateDark && lighten.Count < 5)
                {
                    lighten.Add((
                        await Codec.ToDataUrlAsync(DarkGenerator.Apply(
                            State.GetOriginal(key), State.Project.LightenParams)),
                        await Codec.ToDataUrlAsync(State.GetOriginal(lightKey))));
                }
                if (dark.Count >= 5 && lighten.Count >= 5)
                {
                    break;
                }
            }
            catch
            {
                // originals unavailable for this key — skip the pair
            }
        }
        _darkPairs = dark;
        _lightenPairs = lighten;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Nothing below can work on a browser missing the APIs it depends on, and each
            // restore would fail separately and read as the app being broken.
            if (!Support.IsSupported)
            {
                return;
            }
            _selfRef = DotNetObjectReference.Create(this);
            await Codec.RegisterPasteHandlerAsync(_selfRef);
            await RestoreLayoutAsync();
            _hasStoredWorkspace = await State.Workspace.HasStoredHandleAsync();
            await State.ReconnectWorkspaceAsync(interactive: false);
            // Re-grant the search folder silently, but only scan when there is nothing to
            // work on yet — a scan is thousands of directory listings, not worth doing on a
            // session that already has its game data.
            if (await State.ContentSearch.RestoreAsync(interactive: false) && State.Archive is null)
            {
                await State.SearchForGameDataAsync();
            }
            StateHasChanged();
        }
    }

    // ---- Resizable layout (persisted in localStorage) ----

    private enum SplitterKind { None, Sidebar, Props }

    private int _sidebarWidth = 360;
    private int _propsWidth = 340;
    private readonly bool[] _collapsed = new bool[2];
    private bool _jobsOpen;
    private bool _notifFilterOpen;
    private SplitterKind _dragKind;

    private (double X, double Y) _dragOrigin;
    private int _dragStartValue;

    private void BeginSplitterDrag(SplitterKind kind, PointerEventArgs e)
    {
        _dragKind = kind;
        _dragOrigin = (e.ClientX, e.ClientY);
        _dragStartValue = kind == SplitterKind.Sidebar ? _sidebarWidth : _propsWidth;
    }

    private void OnSplitterMove(PointerEventArgs e)
    {
        switch (_dragKind)
        {
            case SplitterKind.Sidebar:
                _sidebarWidth = Math.Clamp(_dragStartValue + (int)(e.ClientX - _dragOrigin.X), 220, 900);
                break;
            case SplitterKind.Props:
                _propsWidth = Math.Clamp(_dragStartValue + (int)(e.ClientX - _dragOrigin.X), 240, 700);
                break;
        }
    }

    private async Task EndSplitterDrag()
    {
        if (_dragKind == SplitterKind.None)
        {
            return;
        }
        _dragKind = SplitterKind.None;
        await PersistLayoutAsync();
    }

    private async Task PersistLayoutAsync() =>
        await JS.InvokeVoidAsync("localStorage.setItem", "studio-layout",
            $"v2,{_sidebarWidth},{_propsWidth}," +
            $"{(_collapsed[0] ? 1 : 0)},{(_collapsed[1] ? 1 : 0)}," +
            $"{State.ItemColumns},{State.FrameThumbSize}");

    private async Task RestoreLayoutAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "studio-layout");
            var parts = stored?.Split(',');
            if (parts is { Length: >= 7 } && parts[0] == "v2")
            {
                if (int.TryParse(parts[1], out var w))
                {
                    _sidebarWidth = Math.Clamp(w, 220, 900);
                }
                if (int.TryParse(parts[2], out var pw))
                {
                    _propsWidth = Math.Clamp(pw, 240, 700);
                }
                _collapsed[0] = parts[3] == "1";
                _collapsed[1] = parts[4] == "1";
                if (int.TryParse(parts[5], out var itemSize) &&
                    int.TryParse(parts[6], out var thumbSize))
                {
                    State.ItemColumns = itemSize is >= 2 and <= 12 ? itemSize : 5;
                    State.FrameThumbSize = Math.Clamp(thumbSize, 24, 96);
                }
            }
            else if (parts is { Length: >= 3 } && int.TryParse(parts[0], out var legacyW))
            {
                // Legacy v1 CSV: sidebar width + section heights/collapses + sizes.
                _sidebarWidth = Math.Clamp(legacyW, 220, 900);
                if (parts.Length >= 6)
                {
                    _collapsed[0] = parts[3] == "1";
                    _collapsed[1] = parts[4] == "1";
                }
                if (parts.Length >= 8 &&
                    int.TryParse(parts[6], out var itemSize) &&
                    int.TryParse(parts[7], out var thumbSize))
                {
                    State.ItemColumns = itemSize is >= 2 and <= 12 ? itemSize : 5;
                    State.FrameThumbSize = Math.Clamp(thumbSize, 24, 96);
                }
            }
        }
        catch
        {
            // defaults are fine
        }
    }

    [JSInvokable]
    public async Task OnImagePasted(byte[] png) => await State.CreateImportJobAsync(png);

    private async Task OnStyleRefSwapSelected(StyleRefInfo reference, InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await State.SwapStyleRefAsync(reference, buffer.ToArray());
        }
        catch (Exception ex)
        {
            State.Fail($"Style reference swap failed: {ex.Message}");
        }
    }

    private async Task OnStyleRefsSelected(InputFileChangeEventArgs e)
    {
        try
        {
            foreach (var file in e.GetMultipleFiles(8))
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                await State.AddStyleRefAsync(buffer.ToArray());
            }
        }
        catch (Exception ex)
        {
            State.Fail($"Style reference load failed: {ex.Message}");
        }
    }

    private async Task OnGameDataSelected(InputFileChangeEventArgs e)
    {
        if (!State.Workspace.IsOpen)
        {
            State.Fail("Open a workspace first — everything you do is stored there.");
            return;
        }
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            State.LoadGameData(buffer.ToArray(), e.File.Name);
        }
        catch (Exception ex)
        {
            State.Fail($"{State.Game.Name} game data load failed: {ex.Message}");
        }
    }

    private async Task RefreshModels()
    {
        try
        {
            _models = await Gemini.ListImageModelsAsync(State.ApiKey);
        }
        catch (Exception ex)
        {
            _models = [$"error: {ex.Message}"];
        }
    }
