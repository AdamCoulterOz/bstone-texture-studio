<div class="statusbar">
    @if (State.Workspace.IsOpen)
    {
        <span class="ws-split" title="@(State.Workspace.WritesBlocked ? "connected read-only — writes refused by the browser" : "workspace folder")">
            <span class="ws-name @(State.Workspace.WritesBlocked ? "blocked" : "")">
                @(State.Workspace.WritesBlocked ? "⚠" : "📁") @State.Workspace.Name
            </span>
            <button class="ws-close close-btn" title="close workspace (flushes a final save)"
                    @onclick="State.CloseWorkspaceAsync"><IconDismiss Size="11" /></button>
        </span>
    }
    else
    {
        <button @onclick="State.OpenWorkspaceAsync">Open workspace…</button>
        @if (_hasStoredWorkspace)
        {
            <button @onclick="() => State.ReconnectWorkspaceAsync(true)">Reconnect</button>
        }
    }
    @if (State.Busy)
    {
        <FluentProgressRing Style="width:14px;height:14px" />
    }
    <span class="statusbar-spacer"></span>
    @if (State.Jobs.Count > 0)
    {
        var inProgress = State.Jobs.Count(j => j.State is JobState.Queued or JobState.Running);
        var attention = State.Jobs.Count(j => j.State is JobState.AwaitingReview or JobState.Placing);
        var done = State.Jobs.Count(j => j.State == JobState.Done);
        var failed = State.Jobs.Count(j => j.State == JobState.Failed);
        var cancelled = State.Jobs.Count(j => j.State == JobState.Cancelled);
        var interrupted = State.Jobs.Count(j => j.State == JobState.Interrupted);
        <div class="jobs-wrap">
            @if (_jobsOpen)
            {
                <div class="menu-backdrop" @onclick="() => _jobsOpen = false"></div>
                <div class="jobs-popup" @onclick="() => _jobsOpen = false">
                    <JobsPanel />
                </div>
            }
            <button class="jobs-btn @(_jobsOpen ? "active" : "")"
                    @onclick="() => _jobsOpen = !_jobsOpen">
                @if (inProgress > 0)
                {
                    <FluentProgressRing Style="width:14px;height:14px" />
                }
                Jobs
                @if (inProgress > 0)
                {
                    <span class="pill pill-progress" title="@inProgress in progress">@inProgress</span>
                }
                @if (attention > 0)
                {
                    <span class="pill pill-review" title="@attention awaiting you">@attention</span>
                }
                @if (done > 0)
                {
                    <span class="pill pill-done" title="@done completed">@done</span>
                }
                @if (failed > 0)
                {
                    <span class="pill pill-failed" title="@failed failed">@failed</span>
                }
                @if (cancelled > 0)
                {
                    <span class="pill pill-cancelled" title="@cancelled cancelled">@cancelled</span>
                }
                @if (interrupted > 0)
                {
                    <span class="pill pill-cancelled" title="@interrupted interrupted">@interrupted</span>
                }
            </button>
        </div>
    }
</div>

