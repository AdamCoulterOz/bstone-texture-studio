    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (State.ActiveJob is not null)
        {
            // Re-size when the grid tab next shows.
            _promptSizedFor = null;
            return;
        }
        if (State.ActiveGroup is { } promptGroup && !ReferenceEquals(promptGroup, _promptSizedFor))
        {
