@code {
    private const int PreviewEncodeMaxWidth = 1600;

    // Placement stage size in px — the CSS var --stage and the pointer math share this
    // field, so drags stay exact at any zoom.
    private double _placementPx = 240;
    private bool _placementHelpOpen;

    private string _newGroupName = "";
    private bool _newGroupOpen;
    private bool _ctaMenuOpen;
    private int _activeBlock;
    private bool _showPrompt;
    private (double X, double Y)? _dragStart;
    private RevisionRegion? _dragRegion;
    private SlicePlacement? _placementDrag;
    private SlicePlacement? _placementFocus;
    private (double X, double Y) _placementPointerStart;
    private (double X, double Y) _placementOffsetStart;
    private readonly Dictionary<SlicePlacement, ElementReference> _stageRefs = [];
    private bool _scaleHeld;

    private void PlacementKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "s")
        {
            _scaleHeld = false;
        }
        State.SchedulePlacementSave();
    }

    private static string PlacementStyle(SlicePlacement p) =>
        FormattableString.Invariant(
            $"left:{p.OffsetX * 100:0.###}%; top:{p.OffsetY * 100:0.###}%; width:{p.Scale * 100:0.###}%; height:{p.Scale * 100:0.###}%; transform:rotate({p.Rotation:0.#}deg)");

    private string PlacementLabel(SlicePlacement p)
    {
        var purpose = State.GetMeta(p.TileKey).Purpose;
        return purpose.Length > 0 ? purpose : State.FramePurposePlaceholder(p.TileKey);
    }

    private void PlacementDown(SlicePlacement p, PointerEventArgs e)
    {
        _placementFocus = p;
        if (!p.Included)
        {
            return;
        }
        _placementDrag = p;
        _placementPointerStart = (e.ClientX, e.ClientY);
        _placementOffsetStart = (p.OffsetX, p.OffsetY);
    }

    private void PlacementMove(SlicePlacement p, PointerEventArgs e)
    {
        if (_placementDrag != p)
        {
            return;
        }
        p.OffsetX = _placementOffsetStart.X + (e.ClientX - _placementPointerStart.X) / _placementPx;
        p.OffsetY = _placementOffsetStart.Y + (e.ClientY - _placementPointerStart.Y) / _placementPx;
    }

    private void PlacementUp() => _placementDrag = null;

    private void SetPlacementScale(SlicePlacement p, ChangeEventArgs e)
    {
        if (!int.TryParse((string?)e.Value, out var percent))
        {
            return;
        }
        var scale = Math.Clamp(percent / 100.0, 0.1, 2.5);
        // Pivot the zoom on the art's center so the slider doesn't walk it away.
        p.OffsetX += (p.Scale - scale) * p.AnchorX;
        p.OffsetY += (p.Scale - scale) * p.AnchorY;
        p.Scale = scale;
        State.SchedulePlacementSave();
    }

    private void ResetPlacement(SlicePlacement p)
    {
        p.Scale = p.Auto.Scale;
        p.OffsetX = p.Auto.OffsetX;
        p.OffsetY = p.Auto.OffsetY;
        p.Rotation = p.Auto.Rotation;
    }

    private void SetPlacementRotation(SlicePlacement p, ChangeEventArgs e)
    {
        if (int.TryParse((string?)e.Value, out var degrees))
        {
            p.Rotation = Math.Clamp(degrees, -180, 180);
        }
        State.SchedulePlacementSave();
    }

    /// <summary>AABB of the art's significant-bounds rect in cell space, carried through
    /// scale and the rotation about the placed rect's center — the box the alignment
    /// commands aim.</summary>
    private static (double MinX, double MinY, double MaxX, double MaxY) VisibleAabb(SlicePlacement p)
    {
        var rad = p.Rotation * Math.PI / 180.0;
        var cos = Math.Cos(rad);
        var sin = Math.Sin(rad);
        var pivotX = p.OffsetX + p.Scale / 2;
        var pivotY = p.OffsetY + p.Scale / 2;
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var (bx, by) in new[]
                 {
                     (p.BoundsX, p.BoundsY),
                     (p.BoundsX + p.BoundsW, p.BoundsY),
                     (p.BoundsX, p.BoundsY + p.BoundsH),
                     (p.BoundsX + p.BoundsW, p.BoundsY + p.BoundsH),
                 })
        {
            var cx = p.OffsetX + p.Scale * bx;
            var cy = p.OffsetY + p.Scale * by;
            var rx = pivotX + (cx - pivotX) * cos - (cy - pivotY) * sin;
            var ry = pivotY + (cx - pivotX) * sin + (cy - pivotY) * cos;
            minX = Math.Min(minX, rx);
            maxX = Math.Max(maxX, rx);
            minY = Math.Min(minY, ry);
            maxY = Math.Max(maxY, ry);
        }
        return (minX, minY, maxX, maxY);
    }

    private static void AlignLeft(SlicePlacement p) => p.OffsetX -= VisibleAabb(p).MinX;
    private static void AlignRight(SlicePlacement p) => p.OffsetX += 1 - VisibleAabb(p).MaxX;
    private static void AlignTop(SlicePlacement p) => p.OffsetY -= VisibleAabb(p).MinY;
    private static void AlignBottom(SlicePlacement p) => p.OffsetY += 1 - VisibleAabb(p).MaxY;

    /// <summary>The significant-bounds CENTER carried through scale and rotation — the
    /// point the centering commands pin to the cell's middle (edges use the AABB).</summary>
    private static (double X, double Y) RotatedAnchor(SlicePlacement p)
    {
        var rad = p.Rotation * Math.PI / 180.0;
        var relX = p.Scale * (p.AnchorX - 0.5);
        var relY = p.Scale * (p.AnchorY - 0.5);
        var pivotX = p.OffsetX + p.Scale / 2;
        var pivotY = p.OffsetY + p.Scale / 2;
        return (pivotX + relX * Math.Cos(rad) - relY * Math.Sin(rad),
                pivotY + relX * Math.Sin(rad) + relY * Math.Cos(rad));
    }

    private static void CenterHorizontally(SlicePlacement p) =>
        p.OffsetX += 0.5 - RotatedAnchor(p).X;

    private static void CenterVertically(SlicePlacement p) =>
        p.OffsetY += 0.5 - RotatedAnchor(p).Y;


    /// <summary>Snap the new art onto the currently applied redraw's significant bounds —
    /// the fastest way to keep a frame registered with an already-approved take.</summary>
    private void MatchApplied(SlicePlacement p)
    {
        var applied = State.GetRedraw(p.TileKey);
        if (applied is null ||
            SpriteFootprint.SignificantBounds(applied) is not { } target)
        {
            return;
        }
        var placement = SpriteFootprint.PlacementIntoBox(p.Keyed, target);
        p.Scale = placement.Scale;
        p.OffsetX = placement.OffsetX;
        p.OffsetY = placement.OffsetY;
    }

    private async Task PlacementKey(SlicePlacement p, KeyboardEventArgs e)
    {
        if (e.Key == "Tab")
        {
            var sprites = State.ActiveJob?.Placements?.Where(x => x.IsSprite).ToList();
            if (sprites is { Count: > 0 })
            {
                var index = sprites.IndexOf(p);
                var next = sprites[((index < 0 ? 0 : index) + (e.ShiftKey ? -1 : 1) +
                                    sprites.Count) % sprites.Count];
                _placementFocus = next;
                if (_stageRefs.TryGetValue(next, out var stage))
                {
                    await stage.FocusAsync();
                }
            }
            return;
        }
        if (!p.Included)
        {
            return;
        }
        var step = (e.ShiftKey ? 8.0 : 1.0) / 512.0;
        var scaleStep = e.ShiftKey ? 0.05 : 0.01;
        switch (e.Key)
        {
            case "s": _scaleHeld = true; break;
            case "ArrowLeft":
                if (_scaleHeld) { NudgeScale(p, -scaleStep); } else { p.OffsetX -= step; }
                break;
            case "ArrowRight":
                if (_scaleHeld) { NudgeScale(p, +scaleStep); } else { p.OffsetX += step; }
                break;
            case "ArrowUp": p.OffsetY -= step; break;
            case "ArrowDown": p.OffsetY += step; break;
            case "[": NudgeScale(p, -0.01); break;
            case "]": NudgeScale(p, +0.01); break;
            case ",": p.Rotation = Math.Clamp(p.Rotation - (e.ShiftKey ? 15 : 1), -180, 180); break;
            case ".": p.Rotation = Math.Clamp(p.Rotation + (e.ShiftKey ? 15 : 1), -180, 180); break;
            case "0": ResetPlacement(p); break;
            case "a": MatchApplied(p); break;
            case "c": CenterHorizontally(p); break;
            case "m": CenterVertically(p); break;
            case "l": AlignLeft(p); break;
            case "r": AlignRight(p); break;
            case "t": AlignTop(p); break;
            case "b": AlignBottom(p); break;
        }
    }

    private void NudgeScale(SlicePlacement p, double delta)
    {
        var scale = Math.Clamp(p.Scale + delta, 0.1, 2.5);
        p.OffsetX += (p.Scale - scale) * p.AnchorX;
        p.OffsetY += (p.Scale - scale) * p.AnchorY;
        p.Scale = scale;
    }

    protected override void OnInitialized() => State.OnChange += StateHasChanged;

    public void Dispose() => State.OnChange -= StateHasChanged;

    private void OnGroupSelected(ChangeEventArgs e)
    {
        var index = int.Parse((string)e.Value!);
        State.ActiveGroup = index >= 0 && index < State.Project.Groups.Count
            ? State.Project.Groups[index]
            : null;
        _platterSel.Clear();
        _platterAnchor = -1;
        State.Notify();
    }

    private void CreateGroupFromMenu()
    {
        if (!string.IsNullOrWhiteSpace(_newGroupName))
        {
            State.AddGroup(_newGroupName.Trim());
            _newGroupName = "";
            _newGroupOpen = false;
        }
    }

    private void OnNewGroupKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CreateGroupFromMenu();
        }
        else if (e.Key == "Escape")
        {
            _newGroupOpen = false;
        }
    }

    private void DropOn(TileGroup group, int index)
    {
        _dropTarget = null;
        var dropped = DragPayload.Keys;
        DragPayload.Keys = [];
        // Derived darks are engine-generated from their lights; they never go on sheets.
        var keys = dropped.Where(k => !State.IsDerivedDark(k)).ToList();
        if (keys.Count == 0)
        {
            if (dropped.Count > 0)
            {
                State.Fail("Derived-dark frames are excluded from sheets — they're generated " +
                           "from their light sources.");
            }
            return;
        }
        // Keys already in the group move to the drop position instead of duplicating.
        foreach (var key in keys)
        {
            var existing = group.TileKeys.IndexOf(key);
            if (existing >= 0)
            {
                group.TileKeys.RemoveAt(existing);
                if (existing < index)
                {
                    index--;
                }
            }
        }
        group.TileKeys.InsertRange(Math.Clamp(index, 0, group.TileKeys.Count), keys);
        ClearPlatterSelection(group);
        State.Notify();
    }

    private void Remove(TileGroup group, int index)
    {
        group.TileKeys.RemoveAt(index);
        ClearPlatterSelection(group);
        State.Notify();
    }

    // ---- Platter cell selection & seamless runs ----

    private readonly HashSet<int> _platterSel = [];
    private int _platterAnchor = -1;

    private static string Pct(double v, double canvas) =>
        FormattableString.Invariant($"{100 * v / canvas:0.###}%");

    /// <summary>Reorders and removals shift indexes, so the selection can't survive them;
    /// runs broken by the mutation dissolve too.</summary>
    private void ClearPlatterSelection(TileGroup group)
    {
        _platterSel.Clear();
        _platterAnchor = -1;
        StudioState.ValidateRuns(group);
    }

    /// <summary>A merged run acts as one selectable item — clicking any member selects the
    /// whole run's index block.</summary>
    private List<int> RunIndexes(TileGroup group, int index)
    {
        var run = StudioState.RunContaining(group, group.TileKeys[index]);
        if (run is null)
        {
            return [index];
        }
        var start = group.TileKeys.IndexOf(run[0]);
        return start < 0 ? [index] : Enumerable.Range(start, run.Count).ToList();
    }

    private void CellClick(TileGroup group, int index, MouseEventArgs e)
    {
        var multi = e.CtrlKey || e.MetaKey;
        if (e.ShiftKey && _platterAnchor >= 0 && _platterAnchor < group.TileKeys.Count)
        {
            if (!multi)
            {
                _platterSel.Clear();
            }
            var lo = Math.Min(_platterAnchor, index);
            var hi = Math.Max(_platterAnchor, index);
            for (var i = lo; i <= hi; i++)
            {
                _platterSel.Add(i);
            }
        }
        else if (multi)
        {
            var block = RunIndexes(group, index);
            if (block.All(_platterSel.Contains))
            {
                _platterSel.ExceptWith(block);
            }
            else
            {
                _platterSel.UnionWith(block);
            }
            _platterAnchor = index;
        }
        else
        {
            var block = RunIndexes(group, index);
            if (_platterSel.SetEquals(block))
            {
                // Clicking the sole selected cell/run again deselects it.
                _platterSel.Clear();
                _platterAnchor = -1;
                return;
            }
            _platterSel.Clear();
            _platterSel.UnionWith(block);
            _platterAnchor = index;
        }
        // Partial run selections grow to whole runs so a run always behaves as one item.
        foreach (var i in _platterSel.ToList())
        {
            _platterSel.UnionWith(RunIndexes(group, i));
        }
    }

    /// <summary>The run whose index block exactly equals the current selection, if any —
    /// that's when the Seamless button shows ticked.</summary>
    private List<string>? SelectedRun(TileGroup group)
    {
        if (_platterSel.Count < 2 || _platterSel.Any(i => i >= group.TileKeys.Count))
        {
            return null;
        }
        var run = StudioState.RunContaining(group, group.TileKeys[_platterSel.Min()]);
        if (run is null)
        {
            return null;
        }
        var start = group.TileKeys.IndexOf(run[0]);
        return start >= 0 && _platterSel.SetEquals(Enumerable.Range(start, run.Count))
            ? run
            : null;
    }

    /// <summary>2+ cells selected, contiguous in platter order — eligible to merge. A
    /// selection that swallows existing runs is fine; merging absorbs them.</summary>
    private bool MergeableSelection(TileGroup group)
    {
        if (_platterSel.Count < 2 || _platterSel.Any(i => i >= group.TileKeys.Count))
        {
            return false;
        }
        return _platterSel.Max() - _platterSel.Min() + 1 == _platterSel.Count;
    }

    private void ToggleSeamless(TileGroup group)
    {
        if (SelectedRun(group) is { } run)
        {
            group.SeamlessRuns.Remove(run);
        }
        else if (MergeableSelection(group))
        {
            var keys = _platterSel.OrderBy(i => i).Select(i => group.TileKeys[i]).ToList();
            group.SeamlessRuns.RemoveAll(r => r.Any(keys.Contains));
            group.SeamlessRuns.Add(keys);
        }
        StudioState.ValidateRuns(group);
        State.Notify();
    }

