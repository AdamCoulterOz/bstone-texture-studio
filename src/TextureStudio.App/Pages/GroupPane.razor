        }
    }

    // ---- Platter sorting & drag/drop ----

    private bool _sortAsc = true;

    /// <summary>Sort the platter by frame id (walls first, then sprites, by index);
    /// alternate presses flip the direction. Runs that stay contiguous survive.</summary>
    private void SortCells(TileGroup group)
    {
        var sorted = group.TileKeys
            .OrderBy(k => TileRef.Parse(k).Kind)
            .ThenBy(k => TileRef.Parse(k).Index)
            .ToList();
        if (!_sortAsc)
        {
            sorted.Reverse();
        }
        _sortAsc = !_sortAsc;
        group.TileKeys.Clear();
        group.TileKeys.AddRange(sorted);
        ClearPlatterSelection(group);
        State.Notify();
    }

    private int? _dropTarget;

    /// <summary>Dragging a selected cell carries the whole selection; dragging a run member
    /// carries the whole run — blocks move as one and stay contiguous after the drop.</summary>
    private List<string> DragKeysFor(TileGroup group, int index)
    {
        var indexes = _platterSel.Contains(index) && _platterSel.Count > 1
            ? _platterSel.OrderBy(i => i).ToList()
            : RunIndexes(group, index);
        return indexes.Where(i => i < group.TileKeys.Count)
            .Select(i => group.TileKeys[i]).ToList();
    }

