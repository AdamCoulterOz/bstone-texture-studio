    /// <summary>Add the next-colour revision set (Red → Blue → Green → Amber) and make it
    /// the active marking target.</summary>
    private void AddRevisionSet(GenerationJob job)
    {
        var used = job.Blocks.Select(b => b.ColorIndex).ToHashSet();
        var next = Enumerable.Range(0, 4).Where(i => !used.Contains(i)).DefaultIfEmpty(-1).First();
        if (next < 0)
        {
            return;
        }
        job.Blocks.Add(new RevisionBlock(next));
        _activeBlock = next;
        State.Notify();
    }

    private void RemoveRevisionSet(GenerationJob job, RevisionBlock set)
    {
        job.Blocks.Remove(set);
        if (_activeBlock == set.ColorIndex)
        {
            _activeBlock = job.Blocks.OrderBy(b => b.ColorIndex)
                .Select(b => b.ColorIndex).DefaultIfEmpty(-1).First();
        }
        State.Notify();
    }

    // ---- Region marking (pointer mapped through the MEASURED rendered rect, so the math
    // is exact regardless of how the responsive canvas is currently sized) ----

    private ElementReference _canvasRef;
    private CanvasRect? _dragRect;

    private sealed record CanvasRect(double Left, double Top, double Width, double Height);

    private async Task PointerDown(PointerEventArgs e)
    {
        // Marking targets the active revision set — no set, no drag.
        if (State.ActiveJob is not { } markJob ||
            markJob.Blocks.All(b => b.ColorIndex != _activeBlock))
        {
            return;
        }
        _dragRect = await JS.InvokeAsync<CanvasRect>("studioInterop.getRect", _canvasRef);
        _dragStart = (e.ClientX, e.ClientY);
        _dragRegion = null;
    }

    private void PointerMove(PointerEventArgs e, GenerationJob job)
    {
        if (_dragStart is not { } start || _dragRect is not { Width: > 0 } rect)
        {
            return;
        }
        var scale = job.SheetWidth / rect.Width;
        double Cx(double clientX) => Math.Clamp(clientX - rect.Left, 0, rect.Width) * scale;
        double Cy(double clientY) => Math.Clamp(clientY - rect.Top, 0, rect.Height) * scale;
        var x0 = Math.Min(Cx(start.X), Cx(e.ClientX));
        var y0 = Math.Min(Cy(start.Y), Cy(e.ClientY));
        var w = Math.Abs(Cx(e.ClientX) - Cx(start.X));
        var h = Math.Abs(Cy(e.ClientY) - Cy(start.Y));
        _dragRegion = new RevisionRegion((int)x0, (int)y0, Math.Max(1, (int)w), Math.Max(1, (int)h));
        StateHasChanged();
    }

    private void PointerUp(GenerationJob job)
    {
        // Sets are created only via ＋ — a drag with no active set is discarded.
        if (_dragRegion is { Width: > 8, Height: > 8 } region &&
            job.Blocks.FirstOrDefault(b => b.ColorIndex == _activeBlock) is { } block)
        {
            block.Regions.Add(region);
        }
        _dragStart = null;
        _dragRegion = null;
        _dragRect = null;
        State.Notify();
    }

    /// <summary>Overlay boxes are positioned in percentages of the image, so they stay
    /// aligned at any rendered size.</summary>
    private static string RegionStyle(RevisionRegion region, GenerationJob job) =>
        $"left:{100.0 * region.X / job.SheetWidth:F3}%; top:{100.0 * region.Y / job.SheetHeight:F3}%; " +
        $"width:{100.0 * region.Width / job.SheetWidth:F3}%; height:{100.0 * region.Height / job.SheetHeight:F3}%;";

    private static string ShortKey(string key) => key.Replace("wall:", "w").Replace("sprite:", "s");
